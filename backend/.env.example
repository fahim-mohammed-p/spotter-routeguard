# Django Core
DEBUG=True
SECRET_KEY=replace-with-a-new-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Connection
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# OpenRouteService / HeiGIT API (Required for Pelias geocoding and driving-hgv routing)
# Register for a free API key at https://account.heigit.org
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_GEOCODE_BASE_URL=https://api.heigit.org/pelias/v1

# Open-Meteo Forecast API (Free, no API key required for standard forecast endpoint)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# CORS (Comma-separated origins allowed to access the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Operational tuning
EXTERNAL_API_TIMEOUT_SECONDS=15
WEATHER_CACHE_TTL_SECONDS=900
